<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>MODIT Copilot</title><link rel="stylesheet" href="/css/style.css" /></head>
<body class="app-page"><%- include('partials/header') %>
<main class="container">
  <section class="hero"><div><p class="section-kicker">MODIT COPILOT / PROCUREMENT WORKSPACE</p><h1>Turn a site requirement into an order.</h1><p class="muted">This workspace structures a requirement, calculates a material plan, compares local supplier offers, and confirms a purchase order—all in one tracked workflow.</p></div><div class="panel hero-card"><h3>What the copilot will do</h3><p class="muted">1. Read your brief &nbsp; 2. Build a BOM &nbsp; 3. Rank suppliers &nbsp; 4. Create an RFQ</p><div class="result-box">Every action in this workspace is saved to the MODIT supplier console.</div></div></section>
  <section class="section"><div class="workflow-layout"><article class="card workflow-form"><div class="section-kicker">NEW PROCUREMENT RUN</div><h2>Tell MODIT about the site</h2><form id="procurement-form"><label for="project">Project / site name</label><input id="project" name="project" required value="North Tower Residences" /><div class="form-grid"><div><label for="projectType">Project type</label><select id="projectType" name="projectType"><option value="residential">Residential</option><option value="commercial">Commercial</option><option value="fitout">Fit-out</option></select></div><div><label for="city">Delivery zone</label><select id="city" name="city"><option>Gurugram</option><option>Noida</option><option>Delhi</option><option>Faridabad</option></select></div><div><label for="areaSqft">Built-up area (sq ft)</label><input id="areaSqft" name="areaSqft" type="number" min="200" value="1800" /></div><div><label for="floors">Floors</label><input id="floors" name="floors" type="number" min="1" value="2" /></div></div><label for="requirements">Requirement brief / BOQ notes</label><textarea id="requirements" name="requirements" rows="4" placeholder="e.g. 200 cement bags, Fe500 steel, AAC blocks and electrical cabling">Structure stage: cement, TMT steel, M-sand and AAC blocks. Delivery needed within 48 hours.</textarea><label for="budgetNumber">Working budget (₹)</label><input id="budgetNumber" name="budgetNumber" type="number" min="10000" value="500000" /><button class="btn btn-primary" type="submit">Build procurement plan →</button></form></article>
  <article class="card workflow-output"><div class="section-kicker">LIVE WORKFLOW</div><div id="run-result" class="empty-state"><strong>Ready when you are.</strong><p>Submit the site brief to create a BOM and supplier comparison.</p></div></article></div></section>
  <section class="section"><div class="section-title"><h2>Tools for the site team</h2><span class="muted">Each tool triggers a real prototype workflow</span></div><div class="card-grid"><article class="card"><h3>Voice ordering</h3><p class="muted">Speak a site request and have MODIT prepare its next actions.</p><button id="voice-btn" class="btn btn-secondary">Start voice command</button><div id="voice-result" class="result-box">Browser voice input is ready.</div></article><article class="card"><h3>Supplier matching</h3><p class="muted">Rank vendors using price, quality, location and delivery fit.</p><button id="match-btn" class="btn btn-secondary">Match Gurugram vendors</button><div id="match-result" class="result-box">No vendor search run.</div></article><article class="card"><h3>My procurement activity</h3><p class="muted">Orders and RFQs are persisted locally for this prototype.</p><a href="/dashboard" class="btn btn-secondary">Open supplier console →</a></article></div></section>
</main>
<script>
const el=id=>document.getElementById(id), esc=v=>String(v).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
const money=n=>'₹'+Number(n).toLocaleString('en-IN');
async function api(url,options={}){const r=await fetch(url,{headers:{'Content-Type':'application/json'},...options});const d=await r.json();if(!r.ok)throw new Error(d.error||'Something went wrong');return d}
el('procurement-form').addEventListener('submit',async e=>{e.preventDefault();const f=Object.fromEntries(new FormData(e.currentTarget));const out=el('run-result');out.innerHTML='<strong>MODIT is reading the brief and checking supply…</strong>';try{const boq=await api('/api/ai/boq',{method:'POST',body:JSON.stringify(f)});const rfq=await api('/api/quote-request',{method:'POST',body:JSON.stringify({...f,materials:boq.materials.map(x=>x.name+' ('+x.quantity+')').join(', '),delivery:'Within 48 hrs'})});out.innerHTML=`<div class="success-label">PLAN CREATED · ${esc(rfq.request.id)}</div><h3>${esc(boq.summary)}</h3><p class="muted">${esc(boq.source)}. Estimated material plan: ${boq.materials.length} line items.</p><div class="bom-list">${boq.materials.map(x=>`<div><span>${esc(x.name)}</span><b>${esc(x.quantity)}</b><small>${esc(x.estimate)}</small></div>`).join('')}</div><h3>Ranked supplier offers</h3><div class="quote-list">${rfq.request.quotes.map((q,i)=>`<div><div><strong>${esc(q.supplier)}</strong><small>${esc(q.recommendation)} · ${esc(q.delivery)} · ★ ${q.rating}</small></div><b>${money(q.quote)}</b><button class="btn ${i===0?'btn-primary':'btn-secondary'}" data-rfq="${rfq.request.id}" data-supplier="${q.supplierId}">Choose</button></div>`).join('')}</div><p id="order-message" class="result-box">Select an offer to create a confirmed purchase order and GST invoice draft.</p>`}catch(err){out.innerHTML=`<p class="error">${esc(err.message)}</p>`}});
document.addEventListener('click',async e=>{const b=e.target.closest('[data-rfq]');if(!b)return;b.disabled=true;try{const d=await api('/api/rfqs/'+b.dataset.rfq+'/accept',{method:'POST',body:JSON.stringify({supplierId:b.dataset.supplier})});el('order-message').innerHTML=`<strong>Order ${esc(d.order.id)} confirmed.</strong> ${esc(d.order.supplier)} will deliver in ${esc(d.order.eta)}. GST invoice draft is ready in Supplier OS.`}catch(err){b.disabled=false;el('order-message').textContent=err.message}});
el('match-btn').addEventListener('click',async()=>{const o=el('match-result');o.textContent='Ranking local supply…';try{const d=await api('/api/ai/vendor-match',{method:'POST',body:JSON.stringify({city:'Gurugram',budget:500000,delivery:24,quality:'A'})});o.innerHTML=d.matches.length?d.matches.map(x=>`<strong>${esc(x.name)}</strong> · ${money(x.adjustedQuote)} · ${esc(x.deliveryFit)} fit`).join('<br>'):'No exact match; broadened network search recommended.'}catch(e){o.textContent=e.message}});
el('voice-btn').addEventListener('click',async()=>{const o=el('voice-result'), Speech=window.SpeechRecognition||window.webkitSpeechRecognition;if(!Speech){o.textContent='Voice capture is not supported in this browser. Try Chrome, or use the site brief form.';return}const r=new Speech();r.lang='en-IN';r.onstart=()=>o.textContent='Listening… say a material and delivery location.';r.onerror=()=>o.textContent='Could not hear that. Please try again.';r.onresult=async ev=>{const voice=ev.results[0][0].transcript;o.textContent='Creating workflow for: '+voice;const d=await api('/api/agent/assistant',{method:'POST',body:JSON.stringify({intent:'procurement',location:'Gurugram',voice})});o.innerHTML='<strong>Captured:</strong> '+esc(voice)+'<br>'+d.actions.map(esc).join('<br>')};r.start()});
</script></body></html>
