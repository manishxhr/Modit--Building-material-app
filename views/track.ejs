<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Track MODIT Orders</title><link rel="stylesheet" href="/css/style.css"></head>
<body class="app-page"><%- include('partials/header') %><main class="container"><section class="hero"><div><p class="section-kicker">ORDER CONTROL / DELIVERY VISIBILITY</p><h1>Know what is moving, before the site asks.</h1><p class="muted">Track confirmed material orders from dispatch to delivery. Order statuses are updated from Supplier OS.</p></div><div class="panel hero-card"><h3>Live delivery signals</h3><div class="result-box">GST invoice status, supplier assignment and delivery milestones in one place.</div></div></section><section class="section"><div class="section-title"><h2>Active orders</h2><span class="muted"><%= orders.length %> orders in workspace</span></div><div class="tracking-list"><% orders.forEach(function(order){ %><article class="tracking-row"><div><span class="status-dot <%= order.status.toLowerCase().replaceAll(' ', '-') %>"></span><small>ORDER</small><h3><%= order.id %></h3></div><div><small>PROJECT</small><strong><%= order.customer %></strong></div><div><small>STATUS</small><strong><%= order.status %></strong></div><div><small>ETA</small><strong><%= order.eta %></strong></div><div><small>VALUE</small><strong><%= order.amount %></strong></div></article><% }) %></div></section></main></body></html>
